# PostgreSQL de Supabase (Project Settings > Database > URI)
# Usa el connection string "URI" con el password del proyecto.
DATABASE_URL="postgresql://postgres:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# Supabase Storage (server only; never add the service-role key to the mobile app)
SUPABASE_URL="https://jyacnfqtazaeinoluyuk.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
FRONTEND_ORIGIN="*"
